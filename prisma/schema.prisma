datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  user
}

enum ListingType {
  Sale
  Rent
}

enum ListingStatus {
  pending
  approved
  rejected
  sold
  rented
  inactive
}

enum InquiryStatus {
  new
  contacted
  closed
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String    @db.VarChar(150)
  email              String    @unique @db.VarChar(255)
  phone              String    @unique @db.VarChar(20)
  password_hash      String    @db.VarChar(255)
  role               String    @default("user") @db.VarChar(20)
  is_active          Boolean   @default(true)
  reset_token        String?   @db.VarChar(255)
  reset_token_expires DateTime?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)

  listings           Listing[]
  inquiries          Inquiry[]
  saved_properties   SavedProperty[]
  audit_logs         AuditLog[]

  @@map("users")
}

model Listing {
  id                    Int             @id @default(autoincrement())
  user_id               Int
  title                 String          @db.VarChar(255)
  slug                  String          @unique @db.VarChar(255)
  listing_type          String          @db.VarChar(10)
  property_category     String          @db.VarChar(50)
  bhk                   String?         @db.VarChar(20)
  carpet_area_sqft      Decimal         @db.Decimal(10, 2)
  builtup_area_sqft     Decimal?        @db.Decimal(10, 2)
  floor_number          Int?
  total_floors          Int?
  age_of_property       String?         @db.VarChar(50)
  facing_direction      String?         @db.VarChar(30)
  furnishing_status     String?         @db.VarChar(30)
  bathrooms             Int?            @default(1)
  balconies             Int?            @default(0)
  parking               String?         @db.VarChar(50)
  possession_status     String          @db.VarChar(50)
  possession_date       DateTime?       @db.Date
  price                 Decimal         @db.Decimal(14, 2)
  deposit               Decimal?        @default(0) @db.Decimal(14, 2)
  maintenance_charges   Decimal?        @default(0) @db.Decimal(10, 2)
  price_per_sqft        Decimal?        @db.Decimal(10, 2)
  is_negotiable         Boolean?        @default(false)
  locality              String          @db.VarChar(100)
  address               String
  pincode               String          @db.VarChar(10)
  lat                   Decimal         @db.Decimal(9, 6)
  lng                   Decimal         @db.Decimal(9, 6)
  preferred_tenants     String?         @default("Any") @db.VarChar(50)
  description           String
  has_contact_leak_flag Boolean?        @default(false)
  contact_leak_notes    String?
  video_url             String?         @db.VarChar(500)
  cover_image           String?         @db.VarChar(500)
  status                String          @default("pending") @db.VarChar(20)
  rejection_reason      String?
  is_featured           Boolean?        @default(false)
  views_count           Int?            @default(0)
  is_deleted            Boolean?        @default(false)
  created_at            DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?       @default(now()) @db.Timestamptz(6)

  user                  User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  owner_details         OwnerDetail?
  images                ListingImage[]
  amenities             ListingAmenity[]
  inquiries             Inquiry[]
  saved_properties      SavedProperty[]

  @@map("listings")
}

model OwnerDetail {
  id            Int       @id @default(autoincrement())
  listing_id    Int       @unique
  owner_name    String    @db.VarChar(150)
  owner_phone   String    @db.VarChar(30)
  owner_email   String?   @db.VarChar(255)
  owner_address String?
  notes         String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  listing       Listing   @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@map("owner_details")
}

model ListingImage {
  id            Int       @id @default(autoincrement())
  listing_id    Int
  url           String
  caption       String?   @db.VarChar(255)
  display_order Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  listing       Listing   @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@map("listing_images")
}

model Amenity {
  id       Int              @id @default(autoincrement())
  name     String           @unique @db.VarChar(100)
  icon     String?          @db.VarChar(50)
  listings ListingAmenity[]

  @@map("amenities")
}

model ListingAmenity {
  listing_id Int
  amenity_id Int

  listing    Listing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  amenity    Amenity @relation(fields: [amenity_id], references: [id], onDelete: Cascade)

  @@id([listing_id, amenity_id])
  @@map("listing_amenities")
}

model Inquiry {
  id                   Int       @id @default(autoincrement())
  listing_id           Int
  user_id              Int?
  name                 String    @db.VarChar(150)
  phone                String    @db.VarChar(20)
  email                String    @db.VarChar(255)
  message              String
  preferred_visit_time String?   @db.VarChar(100)
  status               String    @default("new") @db.VarChar(20)
  broker_notes         String?
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)

  listing              Listing   @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  user                 User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("inquiries")
}

model SavedProperty {
  id         Int       @id @default(autoincrement())
  user_id    Int
  listing_id Int
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  listing    Listing   @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@unique([user_id, listing_id])
  @@map("saved_properties")
}

model AuditLog {
  id          Int       @id @default(autoincrement())
  admin_id    Int?
  action      String    @db.VarChar(100)
  entity_type String    @db.VarChar(50)
  entity_id   Int?
  details     Json?
  ip_address  String?   @db.VarChar(45)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  admin       User?     @relation(fields: [admin_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model PuneLocality {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(100)
  zone       String    @db.VarChar(50)
  pincode    String    @db.VarChar(10)
  lat        Decimal   @db.Decimal(9, 6)
  lng        Decimal   @db.Decimal(9, 6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("pune_localities")
}

model PlatformSetting {
  id          Int     @id @default(autoincrement())
  key         String  @unique @db.VarChar(50)
  value       String
  description String? @db.VarChar(255)

  @@map("platform_settings")
}
